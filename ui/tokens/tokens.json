  },
  "type": {
    "family": {
      "ui": ["Urbane", "Inter"],
      "title": ["Space Grotesk", "Inter"],
      "caption": ["Space Grotesk", "Inter"],
      "telemetry": ["JetBrains Mono", "IBM Plex Mono"]
    },
    "weight": {
      "headline": 800,
      "ui": 500,
      "accent": 300,
      "title": 700,
      "caption": 500,
      "telemetry": 500
    },
    "sizePt": {
      "telemetryL": 28,
      "telemetryM": 20,
      "telemetryS": 14,
      "body": 13,
      "caption": 11
    },
    "lineHeight": { "numeric": 1.2, "prose": 1.5 },
    "titleTrackingPx": 1.5,
    "telemetryFeatures": ["tnum", "zero"]
  },
  "spacePx": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "xxl": 32 },
  "radiusPx": { "none": 0, "s": 2, "m": 4 },
  "strokePx": { "hairline": 1, "regular": 1.5, "bold": 2.5 },
  "motionMs": { "fast": 120, "normal": 200, "safety": 0 },
  "opacity": { "staleDim": 0.5, "disabled": 0.38 },
  "contrast": {
    "$comment": "WCAG 2.x contrast ratios. A rule checks every fg x bg pair in every theme; a translucent bg is composited over each backdrop ('canvas' = the theme canvas). Telemetry text >= 7:1, other text >= 4.5:1, graphics that carry meaning >= 3:1 (plan 04 §1.2).",
    "rules": [
      { "id": "telemetry-text", "fg": ["text", "textTelemetry"], "bg": ["canvas", "surface", "surfaceGlass"], "backdrops": ["canvas", "#FFFFFF", "#000000"], "min": 7.0 },
      { "id": "muted-text", "fg": ["textMuted"], "bg": ["canvas", "surface"], "min": 4.5 },
      { "id": "accent-text", "fg": ["accentText"], "bg": ["canvas", "surface"], "min": 4.5 },
      { "id": "text-on-accent", "fg": ["textOnAccent"], "bg": ["accent"], "min": 4.5 },
      { "id": "state-label-on-canvas", "fg": ["state.warning", "state.caution", "state.advisory", "state.normal", "state.guidance"], "bg": ["canvas"], "min": 4.5 },
      { "id": "text-on-state-chip", "pairs": [["stateInk.warning", "state.warning"], ["stateInk.caution", "state.caution"], ["stateInk.advisory", "state.advisory"], ["stateInk.normal", "state.normal"], ["stateInk.guidance", "state.guidance"]], "min": 4.5 },
      { "id": "state-graphic", "fg": ["state.warning", "state.caution", "state.advisory", "state.normal", "state.guidance", "state.standby"], "bg": ["canvas", "surface"], "min": 3.0 },
      { "id": "focus-ring", "fg": ["focus"], "bg": ["canvas", "surface"], "min": 3.0 }
    ],
    "exemptions": [
      {
        "theme": "nightOps", "rule": "telemetry-text", "min": 6.2,
        "reason": "Product-owner decision 2026-10-11: keep #FF4D4D, the plan's brightest Night-Ops red, to protect dark adaptation. It reaches 6.42:1 on black and 6.24:1 on Night-Ops panels, so the 7:1 telemetry rule is relaxed for this theme only.",
        "issue": "owner decision 2026-10-11"
      },
      {
        "theme": "standard", "rule": "state-graphic", "fg": "state.standby", "bg": "surface", "min": 2.7,
        "reason": "Brand Sonic Silver #757575 on the #333333 panels is 2.74:1 (< 3:1). Standby is always shown with a textMuted label (DISARMED, OFFLINE), so the grey mark is supplementary. Open: lighten standby to #808080 (3.2:1) or keep the brand grey.",
        "issue": "T0-12 design-token decisions"
      }
    ]
  },
  "deviations": [
    { "token": "standard.accentText, standard.textMuted", "plan": "not specified", "used": "#4DB8FF, #B0B0B0", "reason": "Azure #009CFF is 4.33:1 on the #333333 panels; accent-coloured text there uses a lighter azure. Muted text is the plan's 'dimmed' units/labels." }
  ]
}
