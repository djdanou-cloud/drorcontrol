{
  "$comment": "DrorControl design tokens v0: the single source of visual constants (plan 04 §1-2). Edit here, then run scripts/gen_tokens.py to regenerate the QML singleton and CSS variables. Colours are '#RRGGBB', a '{brand.name}' reference, or {\"hex\": \"#RRGGBB\", \"alpha\": 0..1}. crates/design-tokens checks every contrast rule below.",
  "version": "0.1.0",
  "brand": {
    "carbon": "#212121",
    "graphite": "#424242",
    "smoke": "#FAFAFA",
    "azure": "#009CFF",
    "pizazz": "#FF9400",
    "vapor": "#22D3EE",
    "silver": "#757575"
  },
  "themes": {
    "standard": {
      "name": "Standard",
      "intent": "Indoor/dusk, brand look (default)",
      "typeDelta": 0,
      "strokeScale": 1.0,
      "targetMin": 48,
      "blur": false,
      "color": {
        "canvas": "{brand.carbon}",
        "surface": "#333333",
        "surfaceGlass": { "hex": "#333333", "alpha": 0.85 },
        "border": { "hex": "#FFFFFF", "alpha": 0.08 },
        "separator": "{brand.silver}",
        "text": "{brand.smoke}",
        "textTelemetry": "{brand.smoke}",
        "textMuted": "#B0B0B0",
        "accent": "{brand.azure}",
        "accentText": "#4DB8FF",
        "textOnAccent": "{brand.carbon}",
        "focus": "{brand.azure}",
        "hover": "{brand.vapor}",
        "state": {
          "warning": "#FF3B30",
          "caution": "{brand.pizazz}",
          "advisory": "{brand.vapor}",
          "normal": "#2ECC71",
          "guidance": "#E040FB",
          "standby": "{brand.silver}"
        },
        "stateInk": {
          "warning": "{brand.carbon}",
          "caution": "{brand.carbon}",
          "advisory": "{brand.carbon}",
          "normal": "{brand.carbon}",
          "guidance": "{brand.carbon}"
        },
        "pfd": {
          "skyTop": "#0B5FA5",
          "skyBottom": "{brand.azure}",
          "groundTop": "#6B4A2B",
          "groundBottom": "#3B2A18",
          "symbol": "{brand.smoke}",
          "halo": "#000000"
        }
      }
    },
    "daylight": {
      "name": "Daylight",
      "intent": "Direct sun on a laptop/tablet: matte, no translucency, thicker strokes, larger text",
      "typeDelta": 2,
      "strokeScale": 1.25,
      "targetMin": 56,
      "blur": false,
      "color": {
        "canvas": "#FAFAFA",
        "surface": "#FFFFFF",
        "surfaceGlass": "#FFFFFF",
        "border": "#757575",
        "separator": "#757575",
        "text": "#101010",
        "textTelemetry": "#101010",
        "textMuted": "#565656",
        "accent": "#0066B3",
        "accentText": "#0066B3",
        "textOnAccent": "#FFFFFF",
        "focus": "#0066B3",
        "hover": "#006C85",
        "state": {
          "warning": "#C4001A",
          "caution": "#A85900",
          "advisory": "#006C85",
          "normal": "#0B7A3B",
          "guidance": "#8E24AA",
          "standby": "#5A5A5A"
        },
        "stateInk": {
          "warning": "#FFFFFF",
          "caution": "#FFFFFF",
          "advisory": "#FFFFFF",
          "normal": "#FFFFFF",
          "guidance": "#FFFFFF"
        },
        "pfd": {
          "skyTop": "#005BB5",
          "skyBottom": "#3DA5FF",
          "groundTop": "#8A5A2B",
          "groundBottom": "#4A3015",
          "symbol": "#FFFFFF",
          "halo": "#000000"
        }
      }
    },
    "nightOps": {
      "name": "Night-Ops",
      "intent": "Preserve dark adaptation and NVG compatibility: red monochrome, no blue/green/white emitters; states differ by shape, flash and audio",
      "typeDelta": 0,
      "strokeScale": 1.0,
      "targetMin": 48,
      "blur": false,
      "color": {
        "canvas": "#000000",
        "surface": "#140000",
        "surfaceGlass": "#140000",
        "border": "#4D0000",
        "separator": "#800000",
        "text": "#FF4D4D",
        "textTelemetry": "#FF4D4D",
        "textMuted": "#E64545",
        "accent": "#FF4D4D",
        "accentText": "#FF4D4D",
        "textOnAccent": "#000000",
        "focus": "#FF4D4D",
        "hover": "#E64545",
        "state": {
          "warning": "#FF4D4D",
          "caution": "#E64545",
          "advisory": "#E64545",
          "normal": "#D93636",
          "guidance": "#FF4D4D",
          "standby": "#BF2626"
        },
        "stateInk": {
          "warning": "#000000",
          "caution": "#000000",
          "advisory": "#000000",
          "normal": "#000000",
          "guidance": "#000000"
        },
        "pfd": {
          "skyTop": "#1A0000",
          "skyBottom": "#330000",
          "groundTop": "#260000",
          "groundBottom": "#0D0000",
          "symbol": "#FF4D4D",
          "halo": "#000000"
        }
      }
    },
    "highContrast": {
      "name": "High-Contrast",
      "intent": "Accessibility; follows macOS Increase Contrast",
      "typeDelta": 0,
      "strokeScale": 1.25,
      "targetMin": 48,
      "blur": false,
      "color": {
        "canvas": "#000000",
        "surface": "#000000",
        "surfaceGlass": "#000000",
        "border": "#FFFFFF",
        "separator": "#B0B0B0",
        "text": "#FFFFFF",
        "textTelemetry": "#FFFFFF",
        "textMuted": "#D0D0D0",
        "accent": "#4DB8FF",
        "accentText": "#4DB8FF",
        "textOnAccent": "#000000",
        "focus": "#4DB8FF",
        "hover": "#5CE6FF",
        "state": {
          "warning": "#FF6E66",
          "caution": "#FFB000",
          "advisory": "#5CE6FF",
          "normal": "#5BE38F",
          "guidance": "#F07CFF",
          "standby": "#B0B0B0"
        },
        "stateInk": {
          "warning": "#000000",
          "caution": "#000000",
          "advisory": "#000000",
          "normal": "#000000",
          "guidance": "#000000"
        },
        "pfd": {
          "skyTop": "#0050A0",
          "skyBottom": "#0070D0",
          "groundTop": "#6B4A2B",
          "groundBottom": "#3B2A18",
          "symbol": "#FFFFFF",
          "halo": "#000000"
        }
